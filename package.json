{
  "name": "@kevinbermudezc/context-guard",
  "version": "1.3.1",
  "description": "Intelligent context admission control and token optimization for Claude Code, Cursor, Windsurf, Antigravity, and Agentic AI workflows.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "context-guard": "./dist/bin/context-guard.js",
    "context-guard-hook": "./dist/bin/claude-hook.js",
    "context-guard-mcp": "./dist/bin/mcp-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build": "tsc && chmod +x dist/bin/*.js",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run build && node --test dist/tests/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "windsurf",
    "mcp",
    "model-context-protocol",
    "pretooluse-hook",
    "ai-agent",
    "token-optimization",
    "finops",
    "context-window",
    "typescript"
  ],
  "author": "Kevin Bermudez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinBermudezC/context-guard.git"
  },
  "bugs": {
    "url": "https://github.com/KevinBermudezC/context-guard/issues"
  },
  "homepage": "https://github.com/KevinBermudezC/context-guard#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0"
  }
}
